DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/matcher
# hashing (offline) | ollama (real semantic embeddings)
EMBEDDER=hashing
# regex (baseline) | llm (Ollama, JSON-schema output, regex fills gaps)
EXTRACTOR=regex
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RAG_LLM=false
